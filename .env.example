# Copy this file to .env and fill in the key locally.
# Never commit the real .env file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_BACKGROUND=auto
OPENAI_IMAGE_TIMEOUT=180
OPENAI_IMAGE_MAX_RETRIES=2

# Optional CloseAI-compatible provider. Keep its key separate from OpenAI.
CLOSEAI_API_KEY=
CLOSEAI_BASE_URL=https://closeai.com.ru/v1
CLOSEAI_IMAGE_MODEL=gpt-image-1.5
